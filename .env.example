# Copy to .env.local and fill in from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret of at least 32 characters for the counter/menu session cookie.
STAFF_SESSION_SECRET=
# Optional server-only canonical HTTPS origin for guest QR links. Defaults to
# the HTTPS app request origin. Set this for a stable public address or local testing.
TRACKING_BASE_URL=
